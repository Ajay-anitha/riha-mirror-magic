<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="800" height="800" fill="none">
  <defs>
    <linearGradient id="roseGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#A83250"/>
      <stop offset="50%" stop-color="#8E2640"/>
      <stop offset="100%" stop-color="#5E182A"/>
    </linearGradient>
    <linearGradient id="champagneGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFF8FA"/>
      <stop offset="50%" stop-color="#D8B88A"/>
      <stop offset="100%" stop-color="#D87991"/>
    </linearGradient>
  </defs>
  <rect width="800" height="800" fill="url(#roseGrad)"/>
  <rect x="20" y="20" width="760" height="760" fill="none" stroke="url(#champagneGrad)" stroke-width="1.5" opacity="0.4"/>
  <rect x="35" y="35" width="730" height="730" fill="none" stroke="#F8E5EA" stroke-width="0.8" stroke-dasharray="6 4" opacity="0.3"/>

  <!-- Brand Motif -->
  <g transform="translate(400, 375)" stroke="url(#champagneGrad)" stroke-width="2" fill="none" opacity="0.45">
    <circle cx="0" cy="0" r="45"/>
    <path d="M -25,20 C -25,-15 25,-15 25,20"/>
    <circle cx="0" cy="-15" r="7" fill="#D8B88A"/>
  </g>

  <text x="400" y="455" font-family="'Cormorant Garamond', Georgia, serif" font-size="32" font-weight="600" fill="#FFF8FA" text-anchor="middle" letter-spacing="4" opacity="0.9">
    PARLOUR WORK 16
  </text>
  <text x="400" y="485" font-family="'Montserrat', sans-serif" font-size="13" font-weight="500" fill="#D8B88A" text-anchor="middle" letter-spacing="3" opacity="0.75">
    BEAUTY CREATION
  </text>
</svg>